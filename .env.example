NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Set to loopback only when running behind the supplied local Nginx proxy.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chunai
DB_PASSWORD=change-me-local-db-password
DB_NAME=chunai_platform
# Used only by docker compose to initialize a NEW data volume.
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=chunai-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Development placeholders. Replace with approved documents before deployment.
TERMS_VERSION=2026-10-01
PRIVACY_VERSION=2026-10-01
LEGAL_UPDATED_AT=2026-10-01T00:00:00.000Z
TERMS_HTML="<p>开发环境用户协议占位，请在部署前配置正式协议。</p>"
PRIVACY_HTML="<p>开发环境隐私政策占位，请在部署前配置正式隐私政策。</p>"

# test:e2e requires an isolated database whose name ends in _test.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=chunai_test
TEST_DB_PASSWORD=change-me-local-test-password
TEST_DB_NAME=chunai_auth_test
