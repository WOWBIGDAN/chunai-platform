NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Set to loopback only when running behind the supplied local Nginx proxy.
TRUST_PROXY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chunai
DB_PASSWORD=change-me-local-db-password
DB_NAME=chunai_platform
# Used only by docker compose to initialize a NEW data volume.
MYSQL_ROOT_PASSWORD=change-me-local-root-password

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=chunai-platform
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Explicitly enable only in development/test/staging. Production always rejects test settlement.
COMMERCE_TEST_PAYMENTS=false

# Private MP4 files must be stored outside release directories; never expose this directory in Nginx.
CONTENT_MEDIA_DIR=.data/content-media
PUBLIC_API_URL=http://localhost:3000/api/v1
# Public cover objects must already exist in this OSS bucket; no OSS access key is needed for URL registration.
CONTENT_IMAGE_OSS_HOST=chunai-photo.oss-cn-hangzhou.aliyuncs.com
# Unified uploads remain unavailable until credentials and a separate private bucket are configured.
UPLOAD_OSS_REGION=cn-hangzhou
UPLOAD_OSS_PUBLIC_BUCKET=chunai-photo
UPLOAD_OSS_PRIVATE_BUCKET=
# Prefer an attached ECS RAM role; do not combine it with AccessKey / STS variables.
UPLOAD_OSS_RAM_ROLE=
# Alternative: restricted RAM credentials stored only in this protected environment file.
# UPLOAD_OSS_ACCESS_KEY_ID=
# UPLOAD_OSS_ACCESS_KEY_SECRET=
# UPLOAD_OSS_SECURITY_TOKEN=  # Set only for temporary STS credentials.
# Both buckets: versioning never enabled. Private bucket: private ACL, no anonymous policy.
# Private bucket lifecycle: expire uploads/staging/ after 1 day; never expire final prefixes.
# Configuration and least-privilege permissions: docs/10-unified-uploads.md
# Required to register/read external video links. Generate once, store securely and back up with the database.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never rotate by replacing this value alone: existing encrypted links/passwords need the original key.
CONTENT_MEDIA_ENCRYPTION_KEY=

# Development placeholders. Replace with approved documents before deployment.
TERMS_VERSION=2026-10-01
PRIVACY_VERSION=2026-10-01
LEGAL_UPDATED_AT=2026-10-01T00:00:00.000Z
TERMS_HTML="<p>开发环境用户协议占位，请在部署前配置正式协议。</p>"
PRIVACY_HTML="<p>开发环境隐私政策占位，请在部署前配置正式隐私政策。</p>"

# Aliyun cmapi021863 tracking. Store the real AppCode only in protected server configuration.
# AppKey / AppSecret are not needed by APPCODE authentication.
LOGISTICS_PROVIDER=NONE
LOGISTICS_APPCODE=
LOGISTICS_TIMEOUT_MS=8000
LOGISTICS_SYNC_INTERVAL_SECONDS=1800
LOGISTICS_AUTO_SYNC_DAYS=30
LOGISTICS_SYNC_BATCH_SIZE=10

# test:e2e requires an isolated database whose name ends in _test.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=chunai_test
TEST_DB_PASSWORD=change-me-local-test-password
TEST_DB_NAME=chunai_auth_test
