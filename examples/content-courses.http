@baseUrl = http://47.97.46.242/api/v1
@adminToken = replace-with-admin-access-token
@userToken = replace-with-client-access-token
@courseId = replace-with-a-published-course-uuid
@chapterId = replace-with-a-paid-chapter-uuid
@quoteId = replace-with-quote-uuid
@orderId = replace-with-order-uuid
@refundId = replace-with-refund-uuid
@columnId = replace-with-column-uuid
@coverMediaId = replace-with-CONTENT_COVER-media-uuid
@columnCoverMediaId = replace-with-COLUMN_COVER-media-uuid
@categoryId = replace-with-SCIENCE-category-uuid
@contentId = replace-with-content-uuid
@version = 1
@userId = replace-with-client-user-uuid
@membershipVersion = 0
@membershipStartsAt = 2026-10-25T00:00:00.000Z
@membershipExpiresAt = 2026-11-24T00:00:00.000Z
@ossCoverUrl = https://chunai-photo.oss-cn-hangzhou.aliyuncs.com/replace-with-existing-object.jpg
@bilibiliUrl = replace-with-real-https-bilibili-video-url
@feishuUrl = replace-with-real-https-feishu-share-url
@feishuPassword = replace-with-real-share-password
@videoMediaId = replace-with-registered-video-media-uuid
@memberCourseId = replace-with-MEMBER-video-course-uuid
@memberChapterId = replace-with-non-preview-member-chapter-uuid

### 管理端查看全部 50 条 cs 样本（保留草稿和下架样本）
GET {{baseUrl}}/admin/contents?keyword=cs&pageSize=100
Authorization: Bearer {{adminToken}}

### 公共图文课程列表（无正文）
GET {{baseUrl}}/articles?kind=ARTICLE_COURSE&keyword=cs

### 公共视频科普
GET {{baseUrl}}/videos?kind=SCIENCE_VIDEO&keyword=cs

### 课程目录：取 isPreview=false 的章节测试权限
GET {{baseUrl}}/courses/{{courseId}}/chapters

### 未购买返回 403；购买后返回正文
GET {{baseUrl}}/chapters/{{chapterId}}/body
Authorization: Bearer {{userToken}}

### 课程试算，使用普通用户令牌
POST {{baseUrl}}/order-quotes
Authorization: Bearer {{userToken}}
Content-Type: application/json

{"type":"COURSE","courseId":"{{courseId}}"}

### 从报价创建订单；新业务请换幂等键
POST {{baseUrl}}/orders
Authorization: Bearer {{userToken}}
Idempotency-Key: cs_course_order_00001
Content-Type: application/json

{"quoteId":"{{quoteId}}"}

### 测试支付：使用管理员令牌，取订单最新 version
POST {{baseUrl}}/admin/orders/{{orderId}}/test-payment
Authorization: Bearer {{adminToken}}
Idempotency-Key: cs_course_payment_00001
Content-Type: application/json

{"version":{{version}},"transactionNo":"cs_course_payment_00001"}

### 本人已购课程
GET {{baseUrl}}/me/courses?status=ACTIVE
Authorization: Bearer {{userToken}}

### 视频课程章节访问（mode=STREAM 使用 playbackUrl；EXTERNAL_LINK 使用 externalUrl）
GET {{baseUrl}}/chapters/{{chapterId}}/playback
Authorization: Bearer {{userToken}}

### 全额退款请求：orderVersion 为订单最新版本
POST {{baseUrl}}/admin/orders/{{orderId}}/digital-refund
Authorization: Bearer {{adminToken}}
Idempotency-Key: cs_course_refund_00001
Content-Type: application/json

{"orderVersion":{{version}},"reason":"cs测试全额退款"}

### 测试退款成功：这里 version 是退款流水版本；成功后再次读取付费章应为 403
POST {{baseUrl}}/admin/refunds/{{refundId}}/test-result
Authorization: Bearer {{adminToken}}
Idempotency-Key: cs_course_refund_result_00001
Content-Type: application/json

{"version":{{version}},"result":"SUCCEEDED"}

### 获取科普分类；编辑课程改用 scope=COURSE
GET {{baseUrl}}/categories?scope=SCIENCE

### 创建可增删改查的草稿
POST {{baseUrl}}/admin/contents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"kind":"SCIENCE_ARTICLE","title":"cs新增图文测试","summary":"cs接口测试","coverMediaId":"{{coverMediaId}}","categoryId":"{{categoryId}}","accessPolicy":"FREE","priceCents":0}

### 写科普正文；版本从创建响应读取
PUT {{baseUrl}}/admin/contents/{{contentId}}/body
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}},"bodyHtml":"<p>cs正文测试</p>","imageMediaIds":[]}

### 修改资料：每次读取最新版本
PATCH {{baseUrl}}/admin/contents/{{contentId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}},"title":"cs已修改图文测试"}

### 删除从未发布且无引用的草稿
DELETE {{baseUrl}}/admin/contents/{{contentId}}?version={{version}}
Authorization: Bearer {{adminToken}}

### 专栏列表
GET {{baseUrl}}/admin/columns?keyword=cs
Authorization: Bearer {{adminToken}}

### 新建专栏
POST {{baseUrl}}/admin/columns
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name":"cs新增专栏测试","coverMediaId":"{{columnCoverMediaId}}","description":"cs专栏 CRUD 测试","sortOrder":10}

### 关联内容或修改顺序（不授予课程权益）
PUT {{baseUrl}}/admin/columns/{{columnId}}/contents/{{courseId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"sortOrder":10}

### 移除关联
DELETE {{baseUrl}}/admin/columns/{{columnId}}/contents/{{courseId}}
Authorization: Bearer {{adminToken}}

### 登记 OSS 已存在的公开封面；返回 id 填入 coverMediaId。专栏封面改 purpose=COLUMN_COVER
POST {{baseUrl}}/admin/content-media/images
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"publicUrl":"{{ossCoverUrl}}","mimeType":"image/jpeg","sizeBytes":102400,"purpose":"CONTENT_COVER"}

### 登记 B 站科普视频；不传 accessPassword，未知时长填 0
POST {{baseUrl}}/admin/content-media/external-videos
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"provider":"BILIBILI","externalUrl":"{{bilibiliUrl}}","durationSeconds":0}

### 绑定 B 站素材到 SCIENCE_VIDEO 科普；contentId/videoMediaId/version 使用上一步实际返回值
PUT {{baseUrl}}/admin/contents/{{contentId}}/body
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}},"videoMediaId":"{{videoMediaId}}"}

### 已发布 B 站科普返回 EXTERNAL_LINK；详情和列表不暴露外链
GET {{baseUrl}}/videos/{{contentId}}/playback

### 登记飞书网盘视频；返回摘要不包含链接与密码，不要记录请求密码或授权响应
POST {{baseUrl}}/admin/content-media/external-videos
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"provider":"FEISHU","externalUrl":"{{feishuUrl}}","accessPassword":"{{feishuPassword}}","durationSeconds":0}

### 创建会员视频课程；必须 MEMBER、0 分，不能替换有历史购买订单的课程策略
POST {{baseUrl}}/admin/contents
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"kind":"VIDEO_COURSE","title":"cs会员视频课程测试","summary":"cs飞书外链访问测试","coverMediaId":"{{coverMediaId}}","categoryId":"{{categoryId}}","accessPolicy":"MEMBER","priceCents":0}

### 会员视频章节必须非预览；返回 id 填入 memberChapterId
POST {{baseUrl}}/admin/courses/{{memberCourseId}}/chapters
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"title":"cs会员章节","sortOrder":1,"isPreview":false}

### 绑定飞书素材；videoMediaId 使用飞书素材实际 id，version 使用章节当前版本
PUT {{baseUrl}}/admin/chapters/{{memberChapterId}}/body
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}},"videoMediaId":"{{videoMediaId}}"}

### 先发布章节，version 使用写正文后的章节版本
POST {{baseUrl}}/admin/chapters/{{memberChapterId}}/publish
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}}}

### 再发布课程，version 使用课程当前版本
POST {{baseUrl}}/admin/contents/{{memberCourseId}}/publish
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{version}}}

### 查询指定用户会员；管理员需要 membership:write
GET {{baseUrl}}/admin/users/{{userId}}/membership
Authorization: Bearer {{adminToken}}

### 开通/续期：首次会员 version=0；已有会员使用 membership.version。日期示例必须改成实际期限
PUT {{baseUrl}}/admin/users/{{userId}}/membership
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{membershipVersion}},"startsAt":"{{membershipStartsAt}}","expiresAt":"{{membershipExpiresAt}}","reason":"cs开通或续期会员测试"}

### 本人会员；用 active 判断有效，expiresAt 保留已过期/撤销记录的原到期时间
GET {{baseUrl}}/me/membership
Authorization: Bearer {{userToken}}

### 有效会员才返回飞书 externalUrl/accessPassword；未登录401，无会员403
GET {{baseUrl}}/chapters/{{memberChapterId}}/playback
Authorization: Bearer {{userToken}}

### 管理员专属预览，需要 content:write；无需会员
GET {{baseUrl}}/admin/chapters/{{memberChapterId}}/playback
Authorization: Bearer {{adminToken}}

### 撤销会员：membershipVersion 改为 GET 返回的当前版本；之后再次授权应403
POST {{baseUrl}}/admin/users/{{userId}}/membership/revoke
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"version":{{membershipVersion}},"reason":"cs撤销会员测试"}
